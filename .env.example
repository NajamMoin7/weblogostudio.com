# Copy to .env.local for local development, and set the same values in your hosting provider.

# Public production URL, used for canonical URLs, Open Graph, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://weblogostudio.com

# Optional public email. The phone and address are set in lib/site.js.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Stripe ($99 one-page site deposit on /99) ----
# Server-only secret key from https://dashboard.stripe.com/apikeys (sk_test_... while testing,
# sk_live_... in production). Never prefix with NEXT_PUBLIC_ and never commit a real value.
STRIPE_SECRET_KEY=

# ---- Meta Pixel ----
# Pixel (dataset) ID from Meta Events Manager. Public by design: it ships in the page.
# While empty, the Pixel is not loaded at all.
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Form delivery (server-only; configure ONE option) ----
# Used by the contact form, the quote form and the paid /99/start intake (with logo and photo
# attachments). Without either option, forms show an honest "not connected" message.

# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
FORMS_TO_EMAIL=
FORMS_FROM_EMAIL=

# Option B: POST JSON to any webhook (Zapier, Make, n8n, CRM...). Intake files arrive as
# base64 strings under `attachments`.
FORMS_WEBHOOK_URL=
FORMS_WEBHOOK_SECRET=

# ---- Higgsfield image generation (CLI only: npm run images:generate) ----
# Used only by scripts/higgsfield-generate.mjs on your machine; never needed by the deployed site.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
