# Copy to .env.local for local development, and set the same values in your hosting provider.

# Public production URL, used for canonical URLs, Open Graph, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://weblogostudio.com

# Optional public contact details. Leave empty until confirmed; nothing is shown while empty.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# ---- Form delivery (server-only; configure ONE option) ----
# Without either option, the contact and quote forms show an honest "not connected" message.

# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
FORMS_TO_EMAIL=
FORMS_FROM_EMAIL=

# Option B: POST JSON to any webhook (Zapier, Make, n8n, CRM...)
FORMS_WEBHOOK_URL=
FORMS_WEBHOOK_SECRET=

# ---- Higgsfield image generation (CLI only: npm run images:generate) ----
# Create a key at https://console.higgsfield.ai. Used only by scripts/higgsfield-generate.mjs on
# your machine; never needed by the deployed website and never prefixed with NEXT_PUBLIC_.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
